{{!
    @template mod_videodiagnostic/timeline

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videodiagnostic-timeline-wrap mb-3">
    <div class="videodiagnostic-timeline" role="img" aria-label="{{description}}">
        {{#segments}}
            <span class="videodiagnostic-timeline-segment" style="left: {{left}}%; width: {{width}}%;"
                  title="{{start}} – {{end}}"></span>
        {{/segments}}
    </div>
    <div class="small text-muted mt-1">{{description}}</div>
</div>
