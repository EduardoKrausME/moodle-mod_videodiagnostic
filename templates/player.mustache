{{!
    @template mod_videodiagnostic/player

    Example context (json):
    {
        Aqui tem que criar o context em inglês
    }
}}
<div class="videodiagnostic-player card mb-3" id="{{playerid}}" data-source="{{source}}">
    <div class="card-body">
        {{#html5}}
            <video id="{{playerid}}-media" class="videodiagnostic-video" controls preload="metadata" playsinline>
                <source src="{{{videourl}}}">
            </video>
        {{/html5}}
        {{#youtube}}
            <div id="{{playerid}}-media" class="videodiagnostic-embed" data-videoid="{{videoid}}"></div>
        {{/youtube}}
        {{#vimeo}}
            <iframe id="{{playerid}}-media" class="videodiagnostic-embed" src="{{{embedurl}}}"
                    allow="autoplay; fullscreen; picture-in-picture" allowfullscreen title="Vimeo video"></iframe>
        {{/vimeo}}
        {{#showprogress}}
            <div class="videodiagnostic-progress mt-3">
                <div class="progress" role="progressbar" aria-label="{{progresslabel}}" aria-valuemin="0"
                     aria-valuemax="100" aria-valuenow="{{percent}}">
                    <div class="progress-bar" data-vd-progressbar style="width: {{percent}}%"></div>
                </div>
                <div class="small text-muted mt-1"><span
                        data-vd-progresstext>{{percentformatted}}</span> {{progresslabel}}</div>
            </div>
        {{/showprogress}}
    </div>
</div>
