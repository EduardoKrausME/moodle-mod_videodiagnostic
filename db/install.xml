<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="mod/videodiagnostic/db" VERSION="20260920" COMMENT="XMLDB file for mod_videodiagnostic"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd">
    <TABLES>
        <TABLE NAME="videodiagnostic" COMMENT="Video Diagnostic activity settings">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="course" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="name" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="intro" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="introformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="videosource" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="upload" SEQUENCE="false"/>
                <FIELD NAME="videourl" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="explanationsource" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="none" SEQUENCE="false"/>
                <FIELD NAME="explanationvideourl" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="solution" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="solutionformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="teachercomments" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="teachercommentsformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="materials" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="materialsformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="releaseafterinitial" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="explanationpublished" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="allowpostattempt" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="completiondiagnostic" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="completionpercent" TYPE="number" LENGTH="5" DECIMALS="2" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="course" TYPE="foreign" FIELDS="course" REFTABLE="course" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
        <TABLE NAME="videodiagnostic_questions" COMMENT="Diagnostic questions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videodiagnosticid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="sortorder" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="questiontext" TYPE="text" NOTNULL="true" SEQUENCE="false"/>
                <FIELD NAME="questionformat" TYPE="int" LENGTH="4" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="qtype" TYPE="char" LENGTH="20" NOTNULL="true" DEFAULT="text" SEQUENCE="false"/>
                <FIELD NAME="optionsjson" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="correctanswer" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="expectedstart" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="expectedend" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="tolerance" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="5"
                       SEQUENCE="false"/>
                <FIELD NAME="required" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="weight" TYPE="number" LENGTH="8" DECIMALS="2" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videodiagnosticid" REFTABLE="videodiagnostic"
                     REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity-sortorder" UNIQUE="false" FIELDS="videodiagnosticid, sortorder"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videodiagnostic_attempts" COMMENT="Initial and final diagnostic attempts">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videodiagnosticid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="stage" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="1" SEQUENCE="false"/>
                <FIELD NAME="submitted" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="scoreavailable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="score" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="changedcount" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timesubmitted" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videodiagnosticid" REFTABLE="videodiagnostic"
                     REFFIELDS="id"/>
                <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity-user-stage" UNIQUE="true" FIELDS="videodiagnosticid, userid, stage"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videodiagnostic_responses" COMMENT="Answers to diagnostic questions">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="attemptid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="questionid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="answertext" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="starttime" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="endtime" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="score" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="scoreavailable" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="changedfrominitial" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="attempt" TYPE="foreign" FIELDS="attemptid" REFTABLE="videodiagnostic_attempts"
                     REFFIELDS="id"/>
                <KEY NAME="question" TYPE="foreign" FIELDS="questionid" REFTABLE="videodiagnostic_questions"
                     REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="attempt-question" UNIQUE="true" FIELDS="attemptid, questionid"/>
            </INDEXES>
        </TABLE>
        <TABLE NAME="videodiagnostic_progress" COMMENT="Server-authoritative video viewing progress">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="videodiagnosticid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="duration" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="lastposition" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="uniquewatched" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="totalwatchtime" TYPE="number" LENGTH="12" DECIMALS="3" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="percent" TYPE="number" LENGTH="6" DECIMALS="2" NOTNULL="true" DEFAULT="0"
                       SEQUENCE="false"/>
                <FIELD NAME="watchedsegments" TYPE="text" NOTNULL="false" SEQUENCE="false"/>
                <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
                <FIELD NAME="timemodified" TYPE="int" LENGTH="10" NOTNULL="true" DEFAULT="0" SEQUENCE="false"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="activity" TYPE="foreign" FIELDS="videodiagnosticid" REFTABLE="videodiagnostic"
                     REFFIELDS="id"/>
                <KEY NAME="user" TYPE="foreign" FIELDS="userid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
            <INDEXES>
                <INDEX NAME="activity-user" UNIQUE="true" FIELDS="videodiagnosticid, userid"/>
            </INDEXES>
        </TABLE>
    </TABLES>
</XMLDB>
